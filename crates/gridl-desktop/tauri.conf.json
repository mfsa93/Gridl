{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gridl",
  "version": "0.1.0",
  "identifier": "app.gridl.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "pnpm exec vite --host 127.0.0.1 --port 1420 --strictPort",
      "cwd": "../../frontend"
    },
    "beforeBuildCommand": {
      "script": "pnpm exec vite build",
      "cwd": "../../frontend"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gridl",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
