{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main Gridl window and connection windows",
  "windows": [
    "main",
    "conn-*"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart"
  ]
}
